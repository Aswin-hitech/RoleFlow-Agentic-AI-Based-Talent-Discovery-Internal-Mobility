# ---- Required --------------------------------------------------------------
# Paste the API key for whichever host serves your gpt-oss-120b model.
OPENAI_API_KEY=

# Base URL of the OpenAI-compatible endpoint. Leave blank only if you are
# calling api.openai.com itself.
#   Groq ............ https://api.groq.com/openai/v1
#   Ollama (local) .. http://localhost:11434/v1   <- key can be any non-empty text
#   vLLM (local) .... http://localhost:8000/v1
#   OpenRouter ...... https://openrouter.ai/api/v1
#   Together ........ https://api.together.xyz/v1
#   Cerebras ........ https://api.cerebras.ai/v1
OPENAI_BASE_URL=

# ---- Model -----------------------------------------------------------------
# Model id as the host names it. Examples:
#   Groq / OpenRouter .. openai/gpt-oss-120b
#   Ollama ............. gpt-oss:120b   (run: ollama pull gpt-oss:120b)
#   vLLM ............... whatever you served it as
MODEL_NAME=gpt-oss-120b

TEMPERATURE=0.7
SYSTEM_PROMPT=You are a helpful, concise assistant.

# ---- Server ----------------------------------------------------------------
PORT=5000
FLASK_DEBUG=1
MAX_HISTORY_MESSAGES=40
